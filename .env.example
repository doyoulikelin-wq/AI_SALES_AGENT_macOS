NODE_ENV=production
PORT=8787
DATA_DIR=./data
PROMPT_PATH=./prompts/sales-agent-system.md

# LLM provider: openai, gemini, or stub
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TEMPERATURE=0.3
MAX_TOKENS=1200

# Telegram long polling works on a Mac mini without a public webhook URL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_CHAT_ID=
CUSTOMER_TELEGRAM_ENABLED=true

# Sales controls
REQUIRE_PRICE_APPROVAL=true
PUBLIC_DISCOUNT_LIMIT=0
DEFAULT_CURRENCY=USD
COMPANY_SITE_URL=https://herbaloem.com/
APPROVAL_SLA_HOURS=4
